# Добавленные строки (автоматически)

msgid "Автозакрытие браузера"
msgstr "Auto-close browser"

msgid "Автозапуск FlowLink Proxy вместе с системой"
msgstr "Start FlowLink Proxy with the system"

msgid "Браузер был запущен из FlowLink Proxy. Закрытие браузера может прервать незавершённые действия (скачивание файлов, обновления и т.п.). Если идёт важный процесс — дождитесь его завершения.\n\nВнимание: будут закрыты все процессы выбранного браузера. Если запущено несколько профилей или окон — все они будут закрыты."
msgstr "The browser was launched from FlowLink Proxy. Closing the browser may interrupt unfinished actions (file downloads, updates, etc.). If an important process is running, wait for it to finish.\n\nWarning: all processes of the selected browser will be closed. If multiple profiles or windows are running, all of them will be closed."

msgid "Браузер уже запущен"
msgstr "Browser is already running"

msgid "Браузер уже запущен через FlowLink Proxy и работает через прокси. Повторный запуск не требуется.\n\nЕсли вы хотите перезапустить браузер (например, после изменения настроек), нажмите «Перезапустить браузер». Закрытие браузера может прервать незавершённые действия (скачивание файлов, обновления и т.п.) — дождитесь их завершения.\n\nВнимание: будут закрыты все процессы выбранного браузера. Если запущено несколько профилей или окон — все они будут закрыты."
msgstr "The browser is already running through FlowLink Proxy and works through the proxy. No restart is required.\n\nIf you want to restart the browser (for example, after changing settings), click \"Restart browser\". Closing the browser may interrupt unfinished actions (file downloads, updates, etc.) — wait for them to finish.\n\nWarning: all processes of the selected browser will be closed. If multiple profiles or windows are running, all of them will be closed."

msgid "Все файлы"
msgstr "All files"

msgid "Выберите исполняемый файл браузера"
msgstr "Select the browser executable file"

msgid "Выбрать браузер..."
msgstr "Select browser..."

msgid "Выбрать браузер... ✓"
msgstr "Select browser... ✓"

msgid "Для работы через прокси браузер необходимо закрыть и запустить через FlowLink Proxy. Закрытие браузера может прервать незавершённые действия (скачивание файлов, обновления и т.п.). Если идёт важный процесс — дождитесь его завершения и повторите попытку.\n\nКак завершить процесс вручную:\n{instructions}\n\nВнимание: будут закрыты все процессы выбранного браузера. Если запущено несколько профилей или окон — все они будут закрыты."
msgstr "To work through the proxy, the browser must be closed and launched through FlowLink Proxy. Closing the browser may interrupt unfinished actions (file downloads, updates, etc.). If an important process is running, wait for it to finish and try again.\n\nHow to terminate the process manually:\n{instructions}\n\nWarning: all processes of the selected browser will be closed. If multiple profiles or windows are running, all of them will be closed."

msgid "Завершить работу FlowLink Proxy"
msgstr "Exit FlowLink Proxy"

msgid "Закрывать браузер при выходе из FlowLink Proxy"
msgstr "Close browser when exiting FlowLink Proxy"

msgid "Закрыть браузер"
msgstr "Close browser"

msgid "Закрыть браузер и запустить через FlowLink Proxy"
msgstr "Close browser and launch through FlowLink Proxy"

msgid "Закрыть браузер, запущенный из FlowLink Proxy"
msgstr "Close the browser launched from FlowLink Proxy"

msgid "Закрыть браузер?"
msgstr "Close browser?"

msgid "Запуск с системой"
msgstr "Start with system"

msgid "Запускать браузер автоматически при старте системы"
msgstr "Launch browser automatically at system startup"

msgid "Запустить браузер"
msgstr "Launch browser"

msgid "Запустить выбранный браузер сейчас"
msgstr "Launch the selected browser now"

msgid "Исполняемые файлы"
msgstr "Executable files"

msgid "Маски прокси \"{proxy_label}\" и \"{conflicting_label}\" пересекаются. Включён может быть только один из них."
msgstr "Proxy masks \"{proxy_label}\" and \"{conflicting_label}\" overlap. Only one of them can be enabled."

