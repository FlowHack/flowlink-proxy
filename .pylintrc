[MAIN]
# Конфигурация pylint для FlowLink Proxy.
#
# ВСЕ подавления — inline в конкретных файлах/строках
# с обязательным обоснованием на русском языке.
#
# Исключения:
#   R0801 — единственное правило, которое невозможно подавить
#     inline (работает на стыке двух файлов).
#   good-names — стандартные имена методов unittest.TestCase.

[MESSAGES CONTROL]
# R0801 (duplicate-code): browser_config.py вызывает parse_settings/format_settings
#   из autostart.py — общий формат .flowlink-settings между модулями.
#   Дублирования кода нет, pylint видит похожие строки на стыке двух файлов.
disable=
    R0801,

[FORMAT]
# setUp/tearDown — обязательные методы TestCase, переименование невозможно.
max-line-length=100
good-names=setUp,tearDown

[SIMILARITIES]
min-similarity-lines=6
