{
  "manifest_version": 3,
  "name": "FlowLink Proxy",
  "version": "0.3.0",
  "minimum_chrome_version": "122",
  "key": "",
  "author": "Прискалов Дмитрий Юрьевич (FlowHack)",
  "description": "Управление прокси SOCKS5 с масками адресов",
  "icons": {
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "background/service-worker.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "FlowLink Proxy",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "permissions": [
    "activeTab",
    "alarms",
    "storage"
  ],
  "host_permissions": [
    "http://127.0.0.1:*/*",
    "https://api.github.com/*"
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; style-src 'self'; object-src 'none'; connect-src 'self' http://127.0.0.1:* https://api.github.com"
  }
}
