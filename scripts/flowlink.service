[Unit]
Description=FlowLink Proxy Backend
Documentation=https://github.com/FlowHack/flowlink-proxy
After=network.target network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=%h/.local/share/flowlink-proxy/FlowLink\ Proxy
WorkingDirectory=%h/.local/share/flowlink-proxy
Restart=on-failure
RestartSec=5
StartLimitBurst=5
StartLimitIntervalSec=60
StandardOutput=journal
StandardError=journal
Environment=FLOWLINK_DATA_DIR=%h/.local/share/flowlink-proxy

# Безопасность
NoNewPrivileges=true
ProtectSystem=full
PrivateTmp=true
PrivateDevices=true
ReadWritePaths=%h/.local/share/flowlink-proxy

[Install]
WantedBy=default.target
